{
  "id": "./",
  "name": "Paperscope",
  "short_name": "Paperscope",
  "description": "Free research discovery: search open scholarly databases, ranked against your own research profile, which never leaves your device.",
  "start_url": "./#search",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c1430",
